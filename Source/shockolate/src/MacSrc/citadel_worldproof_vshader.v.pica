; Project Citadel C3D R3D4D PROJECTED VERTEX ALIGN1
; Exact software-projected screen placement with homogeneous painter depth.

.fvec projection[4]
.fvec modelView[4]

.constf constants(0.0, 1.0, -1.0, 0.0)
.alias ones constants.yyyy

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc main
    mov r0, inpos

    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    mov outpos.z, constants.xxxx
    mov outpos.w, r1.wwww

    mov outclr, inclr
    end
.end
