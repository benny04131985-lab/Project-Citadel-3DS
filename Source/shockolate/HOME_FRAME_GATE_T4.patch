 static void citadel_3ds_audio_apt_hook(
     APT_HookType hook,
     void *parameter)
 {
@@
     switch (hook) {
         case APTHOOK_ONSUSPEND:
+            citadel_3ds_suspend_active = true;
+            citadel_3ds_suspend_seen = true;
             v5_log("APT AUDIO HOOK event=ONSUSPEND begin");
             citadel_3ds_audio_suspend();
             v5_log("APT AUDIO HOOK event=ONSUSPEND complete");
             break;

         case APTHOOK_ONSLEEP:
+            citadel_3ds_suspend_active = true;
+            citadel_3ds_suspend_seen = true;
             v5_log("APT AUDIO HOOK event=ONSLEEP begin");
             citadel_3ds_audio_suspend();
             v5_log("APT AUDIO HOOK event=ONSLEEP complete");
             break;

         case APTHOOK_ONRESTORE:
+            citadel_3ds_restore_seen = true;
+            citadel_3ds_suspend_active = false;
             v5_log("APT AUDIO HOOK event=ONRESTORE should_close=%d",
                    aptShouldClose() ? 1 : 0);
             if (!aptShouldClose())
                 citadel_3ds_audio_resume();
             break;

         case APTHOOK_ONWAKEUP:
+            citadel_3ds_restore_seen = true;
+            citadel_3ds_suspend_active = false;
             v5_log("APT AUDIO HOOK event=ONWAKEUP should_close=%d",
                    aptShouldClose() ? 1 : 0);
             if (!aptShouldClose())
                 citadel_3ds_audio_resume();
             break;

         case APTHOOK_ONEXIT:
+            citadel_3ds_suspend_active = true;
+            citadel_3ds_suspend_seen = true;
             v5_log("APT AUDIO HOOK event=ONEXIT");
             citadel_3ds_audio_suspend();
             break;
@@
 }

+/*
+ * Drain the previously submitted Citro3D frame before SDL's event backend
+ * services APT/HOME. This ensures HOME never attempts to capture the LCDs
+ * while Project Citadel still has outstanding PICA200 work.
