+/* -------------------------------------------------------------------------
+ * PROJECT CITADEL 3D S2: true software-rendered world stereo.
+ *
+ * The right pass renders geometry only. The left pass renders normally, then
+ * a per-pixel comparison between the raw left world and the completed left
+ * frame identifies every overlay pixel automatically. Those flat pixels are
+ * retained while untouched world pixels are replaced by the right-eye world.
+ * ------------------------------------------------------------------------- */
+#define CITADEL_3DS_STEREO_PASS_OFF    0
+#define CITADEL_3DS_STEREO_PASS_RIGHT  1
+#define CITADEL_3DS_STEREO_PASS_LEFT   2
+#define CITADEL_3DS_STEREO_SLIDER_MIN  0.015f
+#define CITADEL_3DS_STEREO_MAX_HALF_EYE (FIX_UNIT / 56)
+#define CITADEL_3DS_STEREO_MAX_CONVERGENCE_PIXELS 3
+
+extern g3s_matrix unscaled_matrix;
+extern uchar view360_is_rendering;
+
+static int citadel_3ds_stereo_pass = CITADEL_3DS_STEREO_PASS_OFF;
+static float citadel_3ds_stereo_slider_raw = 0.0f;
+static float citadel_3ds_stereo_slider_curve = 0.0f;
+static bool citadel_3ds_stereo_enabled = false;
+static bool citadel_3ds_stereo_camera_valid = false;
+static fix citadel_3ds_stereo_camera[CAM_COOR_CNT];
+
+static uchar *citadel_3ds_stereo_right_world = NULL;
+static uchar *citadel_3ds_stereo_left_world = NULL;
+static uchar *citadel_3ds_stereo_right_frame = NULL;
+static size_t citadel_3ds_stereo_buffer_bytes = 0;
+static int citadel_3ds_stereo_width = 0;
+static int citadel_3ds_stereo_height = 0;
+static int citadel_3ds_stereo_pitch = 0;
+static bool citadel_3ds_stereo_right_world_valid = false;
+static bool citadel_3ds_stereo_left_world_valid = false;
+static bool citadel_3ds_stereo_right_frame_valid = false;
+
+static bool citadel_3ds_stereo_prepare_buffers(void)
+{
+    grs_bitmap *screen;
+    size_t bytes;
+    uchar *right_world;
+    uchar *left_world;
+    uchar *right_frame;
+
+    if (grd_screen_canvas == NULL)
+        return false;
+
+    screen = &grd_screen_canvas->bm;
+    if (screen->bits == NULL || screen->w <= 0 || screen->h <= 0 ||
+        screen->row < screen->w)
+        return false;
+
+    bytes = (size_t)screen->row * (size_t)screen->h;
+    if (citadel_3ds_stereo_right_world != NULL &&
+        citadel_3ds_stereo_buffer_bytes == bytes &&
+        citadel_3ds_stereo_width == screen->w &&
+        citadel_3ds_stereo_height == screen->h &&
+        citadel_3ds_stereo_pitch == screen->row)
+        return true;
+
+    right_world = (uchar *)malloc(bytes);
+    left_world = (uchar *)malloc(bytes);
+    right_frame = (uchar *)malloc(bytes);
+    if (right_world == NULL || left_world == NULL || right_frame == NULL) {
+        free(right_world); free(left_world); free(right_frame);
+        return false;
+    }
+
+    free(citadel_3ds_stereo_right_world);
+    free(citadel_3ds_stereo_left_world);
+    free(citadel_3ds_stereo_right_frame);
+    citadel_3ds_stereo_right_world = right_world;
+    citadel_3ds_stereo_left_world = left_world;
+    citadel_3ds_stereo_right_frame = right_frame;
+    citadel_3ds_stereo_buffer_bytes = bytes;
+    citadel_3ds_stereo_width = screen->w;
+    citadel_3ds_stereo_height = screen->h;
+    citadel_3ds_stereo_pitch = screen->row;
+    memset(right_world, 0, bytes);
+    memset(left_world, 0, bytes);
+    memset(right_frame, 0, bytes);
+    return true;
+}
+
+void citadel_3ds_stereo_begin_frame(float slider)
+{
+    if (slider < 0.0f) slider = 0.0f;
+    if (slider > 1.0f) slider = 1.0f;
+    citadel_3ds_stereo_slider_raw = slider;
+    citadel_3ds_stereo_slider_curve = slider * slider;
+    citadel_3ds_stereo_enabled =
+        slider >= CITADEL_3DS_STEREO_SLIDER_MIN &&
+        citadel_3ds_stereo_prepare_buffers();
+    citadel_3ds_stereo_pass = CITADEL_3DS_STEREO_PASS_OFF;
+    citadel_3ds_stereo_camera_valid = false;
+    citadel_3ds_stereo_right_world_valid = false;
+    citadel_3ds_stereo_left_world_valid = false;
+    citadel_3ds_stereo_right_frame_valid = false;
+}
+
+int citadel_3ds_stereo_frame_enabled(void)
+{
+    return citadel_3ds_stereo_enabled ? 1 : 0;
+}
+
+void citadel_3ds_stereo_begin_right_pass(void)
+{
+    citadel_3ds_stereo_pass = citadel_3ds_stereo_enabled
+        ? CITADEL_3DS_STEREO_PASS_RIGHT : CITADEL_3DS_STEREO_PASS_OFF;
+}
+
+void citadel_3ds_stereo_begin_left_pass(void)
+{
+    citadel_3ds_stereo_pass = citadel_3ds_stereo_enabled
+        ? CITADEL_3DS_STEREO_PASS_LEFT : CITADEL_3DS_STEREO_PASS_OFF;
+}
+
+void citadel_3ds_stereo_end_frame(void)
+{
+    citadel_3ds_stereo_pass = CITADEL_3DS_STEREO_PASS_OFF;
+    citadel_3ds_stereo_camera_valid = false;
+}
+
+int citadel_3ds_stereo_right_pass_active(void)
+{
+    return citadel_3ds_stereo_pass == CITADEL_3DS_STEREO_PASS_RIGHT;
+}
+
+static bool citadel_3ds_stereo_left_pass_active(void)
+{
+    return citadel_3ds_stereo_pass == CITADEL_3DS_STEREO_PASS_LEFT;
+}
+
+static void citadel_3ds_stereo_cache_camera(void)
+{
+    memcpy(citadel_3ds_stereo_camera, fr_camera_last,
+           sizeof(citadel_3ds_stereo_camera));
+    citadel_3ds_stereo_camera_valid = true;
+}
+
+static bool citadel_3ds_stereo_restore_camera(void)
+{
+    if (!citadel_3ds_stereo_camera_valid) return false;
+    memcpy(fr_camera_last, citadel_3ds_stereo_camera,
+           sizeof(citadel_3ds_stereo_camera));
+    return true;
+}
+
+static bool citadel_3ds_stereo_capture_screen(uchar *destination)
+{
+    if (destination == NULL || !citadel_3ds_stereo_prepare_buffers() ||
+        grd_screen_canvas == NULL || grd_screen_canvas->bm.bits == NULL)
+        return false;
+    memcpy(destination, grd_screen_canvas->bm.bits,
+           citadel_3ds_stereo_buffer_bytes);
+    return true;
+}
+
+static void citadel_3ds_stereo_copy_world_to_screen(bool ok_to_double)
+{
+    gr_set_canvas(grd_screen_canvas);
+    if (_fr_curflags & FR_DOUBLEB_MASK) {
+        if (view360_is_rendering)
+            gr_ubitmap(&_fr->draw_canvas.bm, _fr->xtop, _fr->ytop);
+        else if (ok_to_double) {
+            if (full_game_3d) Fast_FullScreen_Copy(&gDoubleSizeOffCanvas.bm);
+            else Fast_Slot_Copy(&gDoubleSizeOffCanvas.bm);
+        } else {
+            if (full_game_3d) Fast_FullScreen_Copy(&_fr->draw_canvas.bm);
+            else Fast_Slot_Copy(&_fr->draw_canvas.bm);
+        }
+    }
+}
+
+static void citadel_3ds_stereo_restore_world_canvas(bool ok_to_double)
+{
+    if (ok_to_double) gr_set_canvas(&gDoubleSizeOffCanvas);
+    else gr_set_canvas(&_fr->draw_canvas);
+}
+
+static void citadel_3ds_stereo_compose_right_frame(void)
+{
+    const grs_bitmap *screen;
+    int convergence_shift;
+    int y;
+    citadel_3ds_stereo_right_frame_valid = false;
+    if (!citadel_3ds_stereo_right_world_valid ||
+        !citadel_3ds_stereo_left_world_valid ||
+        !citadel_3ds_stereo_prepare_buffers()) return;
+
+    screen = &grd_screen_canvas->bm;
+    convergence_shift =
+        (int)(citadel_3ds_stereo_slider_curve *
+              (float)CITADEL_3DS_STEREO_MAX_CONVERGENCE_PIXELS + 0.5f);
+
+    for (y = 0; y < screen->h; ++y) {
+        const uchar *final_row = screen->bits + (size_t)y * screen->row;
+        const uchar *left_row = citadel_3ds_stereo_left_world +
+            (size_t)y * citadel_3ds_stereo_pitch;
+        const uchar *right_world_row = citadel_3ds_stereo_right_world +
+            (size_t)y * citadel_3ds_stereo_pitch;
+        uchar *right_row = citadel_3ds_stereo_right_frame +
+            (size_t)y * citadel_3ds_stereo_pitch;
+        int x;
+        memcpy(right_row, final_row, (size_t)screen->row);
+        for (x = 0; x < screen->w; ++x) {
+            int source_x;
+            if (final_row[x] != left_row[x]) continue;
+            source_x = x - convergence_shift;
+            if (source_x < 0 || source_x >= screen->w) continue;
+            right_row[x] = right_world_row[source_x];
+        }
+    }
+    citadel_3ds_stereo_right_frame_valid = true;
+}
+
+const uchar *citadel_3ds_stereo_get_right_frame(int *width, int *height,
+                                                 int *pitch, float *slider)
+{
+    if (!citadel_3ds_stereo_right_frame_valid) return NULL;
+    if (width != NULL) *width = citadel_3ds_stereo_width;
+    if (height != NULL) *height = citadel_3ds_stereo_height;
+    if (pitch != NULL) *pitch = citadel_3ds_stereo_pitch;
+    if (slider != NULL) *slider = citadel_3ds_stereo_slider_raw;
+    return citadel_3ds_stereo_right_frame;
+}
