+    const u32 inactive = C2D_Color32(42, 48, 48, 255);
+    const u32 complete = C2D_Color32(56, 190, 176, 255);
+    const u32 current =
+        ((citadel_gpu_presented_frames / 12U) & 1U)
+            ? C2D_Color32(238, 248, 246, 255)
+            : C2D_Color32(116, 224, 208, 255);
+
+    C2D_TargetClear(citadel_gpu_top_target, background);
+    C2D_TargetClear(citadel_gpu_bottom_target, background);
+
+    C2D_SceneBegin(citadel_gpu_top_target);
+
+    if (citadel_v16_splash_ready &&
+        citadel_v16_splash_image.subtex != NULL) {
+        subtexture = citadel_v16_splash_image.subtex;
+        scale_x =
+            (float)CITADEL_3DS_TOP_WIDTH /
+            (float)subtexture->width;
+        scale_y =
+            (float)CITADEL_3DS_TOP_HEIGHT /
+            (float)subtexture->height;
+
+        draw_ok = C2D_DrawImageAt(citadel_v16_splash_image,
+                                  0.0f,
+                                  0.0f,
+                                  0.0f,
+                                  NULL,
+                                  scale_x,
+                                  scale_y);
+    } else {
+        draw_ok = C2D_DrawRectSolid(0.0f,
+                                    0.0f,
+                                    0.0f,
+                                    (float)CITADEL_3DS_TOP_WIDTH,
+                                    (float)CITADEL_3DS_TOP_HEIGHT,
+                                    background);
+    }
+
+    /*
+     * Six compact segments represent the exact T7 lifecycle without exposing
+     * Shock's Save/Load UI: Save wrapper, Save callback, game frame, Load
+     * wrapper, Load callback, loaded frame. The active segment pulses so a
+     * longer SD-card operation never looks frozen.
+     */
+    for (index = 0; index < 6U; ++index) {
+        u32 color = inactive;
+
+        if (step > index + 1U)
+            color = complete;
+        else if (step == index + 1U)
+            color = current;
+
+        C2D_DrawRectSolid(57.0f + (float)index * 48.0f,
+                          224.0f,
+                          0.5f,
+                          38.0f,
+                          5.0f,
+                          color);
+    }
+
+    C2D_SceneBegin(citadel_gpu_bottom_target);
+    C2D_DrawRectSolid(0.0f,
