+bool citadel_3ds_newgame_home_t7_mask_active(void)
+{
+    /*
+     * Do not mask the tutorial or the first usable gameplay frame. The mask
+     * begins only once T7 has actually opened its hidden Save wrapper, and it
+     * remains active through the loaded gameplay frame that proves the
+     * normalization completed.
+     */
+    return citadel_3ds_t7_stage >= CITADEL_T7_SAVE_WRAPPER_PRESENTING &&
+           citadel_3ds_t7_stage <= CITADEL_T7_LOAD_DONE_RENDER_GAME;
+}
+
+unsigned int citadel_3ds_newgame_home_t7_mask_step(void)
+{
+    switch (citadel_3ds_t7_stage) {
+    case CITADEL_T7_SAVE_WRAPPER_PRESENTING:
+        return 1U;
+    case CITADEL_T7_SAVE_CALLBACK_PENDING:
+        return 2U;
+    case CITADEL_T7_SAVE_DONE_RENDER_GAME:
+        return 3U;
+    case CITADEL_T7_LOAD_WRAPPER_PRESENTING:
+        return 4U;
+    case CITADEL_T7_LOAD_CALLBACK_PENDING:
+        return 5U;
+    case CITADEL_T7_LOAD_DONE_RENDER_GAME:
+        return 6U;
+    default:
+        return 0U;
+    }
+}
