+                      0.0f,
+                      (float)CITADEL_3DS_BOTTOM_WIDTH,
+                      (float)CITADEL_3DS_BOTTOM_HEIGHT,
+                      background);
+
+    for (index = 0; index < 6U; ++index) {
+        u32 color = inactive;
+
+        if (step > index + 1U)
+            color = complete;
+        else if (step == index + 1U)
+            color = current;
+
+        C2D_DrawRectSolid(27.0f + (float)index * 46.0f,
+                          116.0f,
+                          0.5f,
+                          36.0f,
+                          8.0f,
+                          color);
+    }
+
+    return draw_ok;
+}
